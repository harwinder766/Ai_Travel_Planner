# Select groq, openai, or gemini.
MODEL_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional live-data integrations. The relevant tools fail explicitly when unset.
OPENWEATHERMAP_API_KEY=
TAVILY_API_KEY=
EXCHANGE_RATE_API_KEY=
GPLACES_API_KEY=

# Comma-separated frontend origins accepted by the API.
CORS_ORIGINS=http://localhost:8501
TRAVEL_API_URL=http://localhost:8000
TRAVEL_API_TIMEOUT=90
